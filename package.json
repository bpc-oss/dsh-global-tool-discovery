{
  "name": "dsh-global-tool-discovery",
  "version": "0.1.0",
  "description": "Global, session-scoped tool discovery and unlock for DSH. Provides dev_tool_search to every preset/conversation.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./session-unlock": "./lib/session-unlock.mjs",
    "./skills": "./lib/skills.mjs",
    "./research-orchestrator": "./lib/research-orchestrator.mjs",
    "./knowledge-ingest": "./lib/knowledge-ingest.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "check": "node --check lib/index.mjs && node --check lib/session-unlock.mjs && node --check lib/skills.mjs && node --check lib/research-orchestrator.mjs && node --check lib/knowledge-ingest.mjs && node --check scripts/check-private.mjs",
    "test": "node --test",
    "check:private": "node scripts/check-private.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "dsh",
    "mcp",
    "tools",
    "plugin",
    "dev-tool-search"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}



